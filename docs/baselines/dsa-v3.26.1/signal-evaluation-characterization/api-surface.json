{
  "agent_tools": [
    {
      "category": "data",
      "description": "Inspect backtest data for a specific skill when skill-scoped stats exist. Provide skill_id for a targeted lookup; use get_strategy_backtest_summary for overall metrics. When skill-scoped rollups are unavailable, returns an informational response instead of fabricating metrics.",
      "name": "get_skill_backtest_summary",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "eval_window_days": {
            "description": "Evaluation window in days (default: 30). How many trading days after signal to evaluate.",
            "type": "integer"
          },
          "skill_id": {
            "description": "Skill identifier, e.g. 'bull_trend'.",
            "type": "string"
          }
        },
        "required": [
          "skill_id"
        ],
        "type": "object"
      },
      "policy": {
        "permissions": [
          "backtest:read"
        ],
        "policy_status": "declared",
        "read_only": true,
        "side_effects": [
          "db_read"
        ]
      },
      "scope": {
        "requires_stock_scope": false,
        "scope_dimensions": []
      },
      "semantic_scope": "legacy_signal_evaluation"
    },
    {
      "category": "data",
      "description": "Get backtest performance data for a specific stock: per-stock summary (win rate, accuracy, avg return) plus recent evaluation records. Read-only, does not trigger new backtests.",
      "name": "get_stock_backtest_summary",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "eval_window_days": {
            "description": "Evaluation window in days (default: 30)",
            "type": "integer"
          },
          "limit": {
            "description": "Max number of recent evaluation records to return (default: 10)",
            "type": "integer"
          },
          "stock_code": {
            "description": "Stock code, e.g., '600519' (A-share), 'AAPL' (US), 'hk00700' (HK)",
            "type": "string"
          }
        },
        "required": [
          "stock_code"
        ],
        "type": "object"
      },
      "policy": {
        "permissions": [
          "backtest:read"
        ],
        "policy_status": "declared",
        "read_only": true,
        "side_effects": [
          "db_read"
        ]
      },
      "scope": {
        "requires_stock_scope": true,
        "scope_dimensions": [
          "stock"
        ]
      },
      "semantic_scope": "legacy_signal_evaluation"
    },
    {
      "category": "data",
      "description": "Legacy alias returning the overall backtest performance summary without triggering new backtests.",
      "name": "get_strategy_backtest_summary",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "eval_window_days": {
            "description": "Evaluation window in days (default: 30). How many trading days after signal to evaluate.",
            "type": "integer"
          }
        },
        "required": [],
        "type": "object"
      },
      "policy": {
        "permissions": [
          "backtest:read"
        ],
        "policy_status": "declared",
        "read_only": true,
        "side_effects": [
          "db_read"
        ]
      },
      "scope": {
        "requires_stock_scope": false,
        "scope_dimensions": []
      },
      "semantic_scope": "legacy_signal_evaluation"
    }
  ],
  "legacy_name_boundary": {
    "formal_backtest_started": false,
    "legacy_prefix": "/api/v1/backtest",
    "not_formal_backtest_prefix": "/api/v1/quant/backtest-runs",
    "semantic_scope": "legacy_signal_evaluation"
  },
  "routes": [
    {
      "methods": [
        "GET"
      ],
      "name": "get_overall_performance",
      "path": "/api/v1/backtest/performance",
      "response_model": "PerformanceMetrics",
      "semantic_scope": "legacy_signal_evaluation",
      "summary": "获取整体回测表现"
    },
    {
      "methods": [
        "GET"
      ],
      "name": "get_stock_performance",
      "path": "/api/v1/backtest/performance/{code}",
      "response_model": "PerformanceMetrics",
      "semantic_scope": "legacy_signal_evaluation",
      "summary": "获取单股回测表现"
    },
    {
      "methods": [
        "GET"
      ],
      "name": "get_backtest_results",
      "path": "/api/v1/backtest/results",
      "response_model": "BacktestResultsResponse",
      "semantic_scope": "legacy_signal_evaluation",
      "summary": "获取回测结果"
    },
    {
      "methods": [
        "POST"
      ],
      "name": "run_backtest",
      "path": "/api/v1/backtest/run",
      "response_model": "BacktestRunResponse",
      "semantic_scope": "legacy_signal_evaluation",
      "summary": "触发回测"
    }
  ],
