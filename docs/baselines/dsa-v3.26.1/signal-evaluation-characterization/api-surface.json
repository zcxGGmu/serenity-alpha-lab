            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "评估窗口（交易日数）",
          "title": "Eval Window Days"
        },
        "force": {
          "default": false,
          "description": "强制重新计算",
          "title": "Force",
          "type": "boolean"
        },
        "limit": {
          "default": 200,
          "description": "最多处理的分析记录数",
          "maximum": 2000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "min_age_days": {
          "anyOf": [
            {
              "maximum": 365,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "分析记录最小天龄（0=不限）",
          "title": "Min Age Days"
        }
      },
      "required": [],
      "title": "BacktestRunRequest"
    },
