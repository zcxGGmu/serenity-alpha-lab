+    def test_request_proxy_defaults_are_isolated_between_fetches(self) -> None:
+        source = self.service.create_source({
+            "name": "market-feed",
+            "url": "https://feeds.example.com/rss.xml",
+            "scope_type": "market",
+        })
+        seen_proxy_kwargs = []
+
+        def fake_get(url, **kwargs):
+            proxies = kwargs.get("proxies")
+            self.assertEqual(proxies, {"http": None, "https": None})
+            proxies["use"] = "false"
+            seen_proxy_kwargs.append(proxies)
+            return self._mock_response()
+
+        with patch("src.services.intelligence_service.requests.get", side_effect=fake_get):
+            first = self.service.fetch_source(source["id"])
+            second = self.service.fetch_source(source["id"])
+
+        self.assertEqual(first["fetched_count"], 2)
+        self.assertEqual(second["fetched_count"], 2)
+        self.assertEqual(len(seen_proxy_kwargs), 2)
+        self.assertIsNot(seen_proxy_kwargs[0], seen_proxy_kwargs[1])
