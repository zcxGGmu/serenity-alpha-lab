+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { quantBacktestApi } from '../quantBacktest';
+
+const { get, post } = vi.hoisted(() => ({
+  get: vi.fn(),
+  post: vi.fn(),
+}));
+
+vi.mock('../index', () => ({
+  default: {
+    get,
+    post,
+  },
+}));
+
+describe('quantBacktestApi', () => {
+  beforeEach(() => {
+    get.mockReset();
+    post.mockReset();
+  });
+
+  it('submits formal portfolio backtest runs with an Idempotency-Key', async () => {
+    post.mockResolvedValueOnce({
+      data: {
+        run_id: 'run_bt_123',
+        task_id: 'task_bt_123',
+        task_status: 'queued',
+        execution_status: 'running',
+        run_type: 'formal_portfolio_backtest',
+        evaluation_type: 'portfolio_backtest',
+        requested_mode: 'formal',
+        spec: { spec_id: 'spec_cn_quality', spec_hash: 'sha256:abc' },
+        dataset_versions: { adjusted_daily_bars: 'dsv_11111111111111111111111111111111' },
+        schema: { name: 'quant.backtest_api_run', version: '1.0.0' },
+        trace: { trace_id: 'trace-bt-1', run_id: 'run-bt-1', stage_id: 'stage-bt-1' },
+        runtime: { formal_backtest_api_started: true, worker_loop_started: false },
+      },
+    });
+
+    const result = await quantBacktestApi.createBacktestRun(
+      {
+        specId: 'spec_cn_quality',
+        specHash: 'sha256:abc',
+        requestedMode: 'formal',
+        screenSnapshotId: 'ssn_22222222222222222222222222222222',
+        screenDefinitionVersionId: 'sdv_33333333333333333333333333333333',
+        datasetVersions: { adjustedDailyBars: 'dsv_11111111111111111111111111111111' },
+        initialCash: 1000000,
+        benchmark: '000300.XSHG',
+        costModelVersion: 'cn_a_share_cost_model@1.0.0',
+      },
+      'idem-quant-lab-1',
+    );
+
+    expect(post).toHaveBeenCalledWith(
+      '/api/v1/quant/backtest-runs',
+      {
+        spec_id: 'spec_cn_quality',
+        spec_hash: 'sha256:abc',
+        requested_mode: 'formal',
+        screen_snapshot_id: 'ssn_22222222222222222222222222222222',
+        screen_definition_version_id: 'sdv_33333333333333333333333333333333',
+        dataset_versions: { adjusted_daily_bars: 'dsv_11111111111111111111111111111111' },
+        initial_cash: 1000000,
+        benchmark: '000300.XSHG',
+        cost_model_version: 'cn_a_share_cost_model@1.0.0',
+      },
+      { headers: { 'Idempotency-Key': 'idem-quant-lab-1' } },
+    );
+    expect(result.runId).toBe('run_bt_123');
+    expect(result.evaluationType).toBe('portfolio_backtest');
+    expect(result.runtime?.workerLoopStarted).toBe(false);
+  });
+
+  it('loads status, metrics, paginated rows, audit and artifact payloads from formal backtest routes', async () => {
+    get
+      .mockResolvedValueOnce({
+        data: {
+          run_id: 'run_bt_123',
+          task_status: 'succeeded',
+          execution_status: 'succeeded',
+          final_status: 'succeeded',
+          effective_mode: 'formal',
+          eligible_for_ranking: true,
+          artifact_bundle: { state: 'formal' },
+          runtime: { formal_backtest_api_started: true, qlib_runtime_started: false },
+        },
+      })
+      .mockResolvedValueOnce({
+        data: {
+          artifact: { kind: 'metrics', artifact_id: 'art_metrics' },
+          payload: { metrics: { cumulative_return: '0.024660', max_drawdown: '-0.011000' } },
+        },
+      })
+      .mockResolvedValueOnce({
+        data: {
+          rows: [{ order_id: 'ord-1', instrument_id: '600519.XSHG', status: 'filled' }],
+          pagination: { page_size: 25, cursor: null, next_cursor: '25', total_count: 40 },
+        },
+      })
+      .mockResolvedValueOnce({
+        data: {
+          rows: [{ instrument_id: '600519.XSHG', weight: '0.240000', market_value: '2460.000' }],
+          pagination: { page_size: 25, cursor: null, next_cursor: null, total_count: 1 },
+        },
+      })
+      .mockResolvedValueOnce({
+        data: {
+          artifact: { kind: 'audit', artifact_id: 'art_audit' },
+          payload: { status: 'pass', outcomes: [{ rule_id: 'lookahead_bias', status: 'pass' }] },
+        },
+      })
+      .mockResolvedValueOnce({
+        data: {
+          artifact: { kind: 'metrics', artifact_id: 'art_metrics' },
+          payload: { metrics: { sharpe_ratio: '1.250000' } },
+        },
+      });
+
+    const status = await quantBacktestApi.getBacktestRun('run_bt_123');
+    const metrics = await quantBacktestApi.getBacktestMetrics('run_bt_123');
+    const orders = await quantBacktestApi.listBacktestOrders('run_bt_123', { pageSize: 25 });
+    const positions = await quantBacktestApi.listBacktestPositions('run_bt_123', { pageSize: 25 });
+    const audit = await quantBacktestApi.getBacktestAudit('run_bt_123');
+    const artifact = await quantBacktestApi.downloadBacktestArtifact('run_bt_123', 'metrics');
+    const metricsPayload = metrics.payload as { metrics: { cumulativeReturn: string } };
+    const auditPayload = audit.payload as { outcomes: Array<{ ruleId: string }> };
+    const artifactPayload = artifact.payload as { metrics: { sharpeRatio: string } };
+
+    expect(get).toHaveBeenNthCalledWith(1, '/api/v1/quant/backtest-runs/run_bt_123');
+    expect(get).toHaveBeenNthCalledWith(2, '/api/v1/quant/backtest-runs/run_bt_123/metrics');
+    expect(get).toHaveBeenNthCalledWith(3, '/api/v1/quant/backtest-runs/run_bt_123/orders', {
+      params: { page_size: 25, cursor: undefined },
+    });
+    expect(get).toHaveBeenNthCalledWith(4, '/api/v1/quant/backtest-runs/run_bt_123/positions', {
+      params: { page_size: 25, cursor: undefined },
+    });
+    expect(get).toHaveBeenNthCalledWith(5, '/api/v1/quant/backtest-runs/run_bt_123/audit');
+    expect(get).toHaveBeenNthCalledWith(6, '/api/v1/quant/backtest-runs/run_bt_123/artifacts/metrics');
+    expect(status.eligibleForRanking).toBe(true);
+    expect(metricsPayload.metrics.cumulativeReturn).toBe('0.024660');
+    expect(orders.rows[0].orderId).toBe('ord-1');
+    expect(positions.rows[0].instrumentId).toBe('600519.XSHG');
+    expect(auditPayload.outcomes[0].ruleId).toBe('lookahead_bias');
+    expect(artifactPayload.metrics.sharpeRatio).toBe('1.250000');
+  });
+
+  it('sends cancel requests without using the legacy Signal Evaluation namespace', async () => {
+    post.mockResolvedValueOnce({
+      data: {
+        run_id: 'run_bt_123',
+        task_status: 'cancelled',
+        execution_status: 'running',
+        termination_reason: 'user_requested_cancel',
+      },
+    });
+
+    const result = await quantBacktestApi.cancelBacktestRun('run_bt_123', 'user_requested_cancel');
+
+    expect(post).toHaveBeenCalledWith(
+      '/api/v1/quant/backtest-runs/run_bt_123/cancel',
+      { reason: 'user_requested_cancel' },
+    );
+    expect(post.mock.calls[0][0]).not.toContain('/api/v1/backtest');
+    expect(result.terminationReason).toBe('user_requested_cancel');
+  });
+});
diff --git a/apps/dsa-web/src/api/quantBacktest.ts b/apps/dsa-web/src/api/quantBacktest.ts
new file mode 100644
index 00000000..4022d19c
--- /dev/null
+++ b/apps/dsa-web/src/api/quantBacktest.ts
@@ -0,0 +1,175 @@
+import apiClient from './index';
+import { toCamelCase } from './utils';
+
+export type QuantBacktestMode = 'preview' | 'formal';
+
+export type QuantBacktestSchemaRef = {
+  name: string;
+  version: string;
+};
+
+export type QuantBacktestTraceRef = {
+  traceId: string;
+  runId?: string | null;
+  stageId?: string | null;
+};
+
+export type QuantBacktestArtifactRef = {
+  kind?: string;
+  artifactId?: string;
+  uri?: string;
+  sha256?: string;
+  contentType?: string;
+  state?: string;
+};
+
+export type QuantBacktestDatasetVersions = Record<string, string>;
+
+export type QuantBacktestCreatePayload = {
+  specId: string;
+  specHash: string;
+  requestedMode: QuantBacktestMode;
+  screenSnapshotId: string;
+  screenDefinitionVersionId: string;
+  datasetVersions: QuantBacktestDatasetVersions;
+  initialCash: number;
+  benchmark: string;
+  costModelVersion: string;
+};
+
+export type QuantBacktestRun = {
+  runId: string;
+  taskId?: string;
+  taskStatus?: string;
+  executionStatus?: string;
+  finalStatus?: string;
+  runType?: string;
+  evaluationType?: string;
+  requestedMode?: QuantBacktestMode | string;
+  effectiveMode?: QuantBacktestMode | string;
+  eligibleForRanking?: boolean;
+  terminationReason?: string;
+  spec?: {
+    specId?: string;
+    specHash?: string;
+  };
+  datasetVersions?: QuantBacktestDatasetVersions;
+  schema?: QuantBacktestSchemaRef;
+  trace?: QuantBacktestTraceRef;
+  resourcePolicy?: Record<string, unknown>;
+  runtime?: Record<string, boolean>;
+  artifactBundle?: QuantBacktestArtifactRef | null;
+  metricsArtifact?: QuantBacktestArtifactRef | null;
+  auditArtifact?: QuantBacktestArtifactRef | null;
+};
+
+export type QuantBacktestArtifactPayload<TPayload = Record<string, unknown>> = {
+  artifact?: QuantBacktestArtifactRef | null;
+  payload: TPayload;
+};
+
+export type QuantBacktestTablePage<TRow = Record<string, unknown>> = {
+  rows: TRow[];
+  pagination: {
+    pageSize: number;
+    cursor?: string | null;
+    nextCursor?: string | null;
+    totalCount: number;
+  };
+};
+
+function isPlainRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+function toSnakeKey(value: string): string {
+  return value.replace(/[A-Z]/g, (match) => `_${match.toLowerCase()}`);
+}
+
+function toSnakeCase(value: unknown): unknown {
+  if (Array.isArray(value)) {
+    return value.map((item) => toSnakeCase(item));
+  }
+
+  if (!isPlainRecord(value)) {
+    return value;
+  }
+
+  return Object.fromEntries(
+    Object.entries(value).map(([key, entry]) => [toSnakeKey(key), toSnakeCase(entry)]),
+  );
+}
+
+function runUrl(runId: string): string {
+  return `/api/v1/quant/backtest-runs/${encodeURIComponent(runId)}`;
+}
+
+export const quantBacktestApi = {
+  async createBacktestRun(
+    payload: QuantBacktestCreatePayload,
+    idempotencyKey: string,
+  ): Promise<QuantBacktestRun> {
+    const response = await apiClient.post<Record<string, unknown>>(
+      '/api/v1/quant/backtest-runs',
+      toSnakeCase(payload),
+      { headers: { 'Idempotency-Key': idempotencyKey } },
+    );
+    return toCamelCase<QuantBacktestRun>(response.data);
+  },
+
+  async getBacktestRun(runId: string): Promise<QuantBacktestRun> {
+    const response = await apiClient.get<Record<string, unknown>>(runUrl(runId));
+    return toCamelCase<QuantBacktestRun>(response.data);
+  },
+
+  async getBacktestMetrics(runId: string): Promise<QuantBacktestArtifactPayload> {
+    const response = await apiClient.get<Record<string, unknown>>(`${runUrl(runId)}/metrics`);
+    return toCamelCase<QuantBacktestArtifactPayload>(response.data);
+  },
+
+  async listBacktestOrders(
+    runId: string,
+    options: { cursor?: string | null; pageSize?: number } = {},
+  ): Promise<QuantBacktestTablePage> {
+    const response = await apiClient.get<Record<string, unknown>>(`${runUrl(runId)}/orders`, {
+      params: {
+        page_size: options.pageSize ?? 100,
+        cursor: options.cursor ?? undefined,
+      },
+    });
+    return toCamelCase<QuantBacktestTablePage>(response.data);
+  },
+
+  async listBacktestPositions(
+    runId: string,
+    options: { cursor?: string | null; pageSize?: number } = {},
+  ): Promise<QuantBacktestTablePage> {
+    const response = await apiClient.get<Record<string, unknown>>(`${runUrl(runId)}/positions`, {
+      params: {
+        page_size: options.pageSize ?? 100,
+        cursor: options.cursor ?? undefined,
+      },
+    });
+    return toCamelCase<QuantBacktestTablePage>(response.data);
+  },
+
+  async getBacktestAudit(runId: string): Promise<QuantBacktestArtifactPayload> {
+    const response = await apiClient.get<Record<string, unknown>>(`${runUrl(runId)}/audit`);
+    return toCamelCase<QuantBacktestArtifactPayload>(response.data);
+  },
+
+  async downloadBacktestArtifact(runId: string, artifactKind: string): Promise<QuantBacktestArtifactPayload> {
+    const response = await apiClient.get<Record<string, unknown>>(
+      `${runUrl(runId)}/artifacts/${encodeURIComponent(artifactKind)}`,
+    );
+    return toCamelCase<QuantBacktestArtifactPayload>(response.data);
+  },
+
+  async cancelBacktestRun(runId: string, reason = 'user_requested_cancel'): Promise<QuantBacktestRun> {
+    const response = await apiClient.post<Record<string, unknown>>(
+      `${runUrl(runId)}/cancel`,
+      { reason },
+    );
+    return toCamelCase<QuantBacktestRun>(response.data);
+  },
+};
