@@ -0,0 +1,179 @@
+import apiClient from './index';
+import { toCamelCase } from './utils';
+
+export type QuantSchemaRef = {
+  name: string;
+  version: string;
+};
+
+export type QuantTraceRef = {
+  traceId: string;
+  runId?: string | null;
+  stageId?: string | null;
+};
+
+export type QuantArtifactManifest = {
+  artifactId?: string;
+  uri?: string;
+  sha256?: string;
+  contentType?: string;
+};
+
+export type QuantDatasetVersions = Record<string, string>;
+
+export type QuantScreenRunMode = 'preview' | 'formal';
+
+export type QuantScreenRunCreatePayload = {
+  screenDefinitionId: string;
+  screenDefinitionVersionId: string;
+  asOf: string;
+  datasetVersions: QuantDatasetVersions;
+  screenSnapshotId: string;
+  runMode: QuantScreenRunMode;
+};
+
+export type QuantScreenRunAccepted = {
+  runId: string;
+  taskId: string;
+  status: string;
+  runType: string;
+  screenDefinitionVersionId: string;
+  screenSnapshotId: string;
+  pipelineSnapshotId: string;
+  asOf: string;
+  datasetVersions: QuantDatasetVersions;
+  schema: QuantSchemaRef;
+  trace: QuantTraceRef;
+  artifact?: QuantArtifactManifest | null;
+};
+
+export type QuantScreenResultStatus = 'passed' | 'failed' | string;
+
+export type QuantExplanationStep = {
+  stage: string;
+  ruleId: string;
+  reason: string;
+  authoritative: boolean;
+  scores?: Record<string, number>;
+  factorContributions?: Record<string, number>;
+  sourceIds?: string[];
+  details?: Record<string, unknown>;
+};
+
+export type QuantScreenResultRow = {
+  instrumentId: string;
+  name?: string | null;
+  status: QuantScreenResultStatus;
+  rank?: number | null;
+  failedStage?: string | null;
+  finalScore?: number | null;
+  stageScores?: Record<string, number>;
+  factorContributions?: Record<string, number>;
+  reasonCodes?: string[];
+  industry?: string | null;
+  explanationSteps?: QuantExplanationStep[];
+};
+
+export type QuantScreenResultsPage = {
+  runId: string;
+  screenSnapshotId: string;
+  pipelineSnapshotId: string;
+  asOf: string;
+  datasetVersions: QuantDatasetVersions;
+  schema: QuantSchemaRef;
+  trace: QuantTraceRef;
+  artifact?: QuantArtifactManifest | null;
+  items: QuantScreenResultRow[];
+  pageSize: number;
+  cursor?: string | null;
+  nextCursor?: string | null;
+  totalCount: number;
+  partial?: boolean;
+  stale?: boolean;
+};
+
+export type QuantScreenComparison = {
+  schema: QuantSchemaRef;
+  previousRunId: string;
+  currentRunId: string;
+  added: string[];
+  removed: string[];
+  retained: string[];
+  statusChanges: Array<Record<string, unknown>>;
+  rankChanges: Array<{
+    instrumentId: string;
+    previousRank?: number | null;
+    currentRank?: number | null;
+  }>;
+  scoreDeltas: Array<{
+    instrumentId: string;
+    delta?: number | null;
+  }>;
+};
+
+function isPlainRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+function toSnakeKey(value: string): string {
+  return value.replace(/[A-Z]/g, (match) => `_${match.toLowerCase()}`);
+}
+
+function toSnakeCase(value: unknown): unknown {
+  if (Array.isArray(value)) {
+    return value.map((item) => toSnakeCase(item));
+  }
+
+  if (!isPlainRecord(value)) {
+    return value;
+  }
+
+  return Object.fromEntries(
+    Object.entries(value).map(([key, entry]) => [toSnakeKey(key), toSnakeCase(entry)]),
+  );
+}
+
+export const quantScreeningApi = {
+  async createScreenRun(
+    payload: QuantScreenRunCreatePayload,
+    idempotencyKey: string,
+  ): Promise<QuantScreenRunAccepted> {
+    const response = await apiClient.post<Record<string, unknown>>(
+      '/api/v1/quant/screen-runs',
+      toSnakeCase(payload),
+      { headers: { 'Idempotency-Key': idempotencyKey } },
+    );
+    return toCamelCase<QuantScreenRunAccepted>(response.data);
+  },
+
+  async getScreenRunResults(
+    runId: string,
+    options: { cursor?: string | null; pageSize?: number } = {},
+  ): Promise<QuantScreenResultsPage> {
+    const response = await apiClient.get<Record<string, unknown>>(
+      `/api/v1/quant/screen-runs/${encodeURIComponent(runId)}/results`,
+      {
+        params: {
+          page_size: options.pageSize ?? 25,
+          cursor: options.cursor ?? undefined,
+        },
+      },
+    );
+    return toCamelCase<QuantScreenResultsPage>(response.data);
+  },
+
+  async getScreenRunResult(runId: string, instrumentId: string): Promise<QuantScreenResultRow> {
+    const response = await apiClient.get<Record<string, unknown>>(
+      `/api/v1/quant/screen-runs/${encodeURIComponent(runId)}/results/${encodeURIComponent(instrumentId)}`,
+    );
+    return toCamelCase<QuantScreenResultRow>(response.data);
+  },
+
+  async compareScreenRuns(previousRunId: string, currentRunId: string): Promise<QuantScreenComparison> {
+    const response = await apiClient.get<Record<string, unknown>>(
+      `/api/v1/quant/screen-runs/${encodeURIComponent(currentRunId)}/comparison`,
+      { params: { previous_run_id: previousRunId } },
+    );
+    return toCamelCase<QuantScreenComparison>(response.data);
+  },
+};
