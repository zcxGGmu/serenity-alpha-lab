+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { quantScreeningApi } from '../quantScreening';
+
+const { get, post } = vi.hoisted(() => ({
+  get: vi.fn(),
+  post: vi.fn(),
+}));
+
+vi.mock('../index', () => ({
+  default: {
+    get,
+    post,
+  },
+}));
+
+describe('quantScreeningApi', () => {
+  beforeEach(() => {
+    get.mockReset();
+    post.mockReset();
+  });
+
+  it('submits screen runs through the Quant Screening API with an Idempotency-Key', async () => {
+    post.mockResolvedValueOnce({
+      data: {
+        run_id: 'run_qs_123',
+        task_id: 'task_123',
+        status: 'queued',
+        run_type: 'quant.screen.run',
+        screen_definition_version_id: 'sdv_11111111111111111111111111111111',
+        screen_snapshot_id: 'ssn_22222222222222222222222222222222',
+        pipeline_snapshot_id: 'sps_33333333333333333333333333333333',
+        as_of: '2026-07-24',
+        dataset_versions: { universe: 'dsv_44444444444444444444444444444444' },
+        schema: { name: 'quant.screen_snapshot', version: '1.0.0' },
+        trace: { trace_id: 'trace-1', run_id: 'run-1', stage_id: 'stage-1' },
+      },
+    });
+
+    const result = await quantScreeningApi.createScreenRun(
+      {
+        screenDefinitionId: 'screen_def_alpha',
+        screenDefinitionVersionId: 'sdv_11111111111111111111111111111111',
+        asOf: '2026-07-24',
+        datasetVersions: { universe: 'dsv_44444444444444444444444444444444' },
+        screenSnapshotId: 'ssn_22222222222222222222222222222222',
+        runMode: 'preview',
+      },
+      'idem-screen-lab-1',
+    );
+
+    expect(post).toHaveBeenCalledWith(
+      '/api/v1/quant/screen-runs',
+      {
+        screen_definition_id: 'screen_def_alpha',
+        screen_definition_version_id: 'sdv_11111111111111111111111111111111',
+        as_of: '2026-07-24',
+        dataset_versions: { universe: 'dsv_44444444444444444444444444444444' },
+        screen_snapshot_id: 'ssn_22222222222222222222222222222222',
+        run_mode: 'preview',
+      },
+      { headers: { 'Idempotency-Key': 'idem-screen-lab-1' } },
+    );
+    expect(result.runId).toBe('run_qs_123');
+    expect(result.schema.name).toBe('quant.screen_snapshot');
+    expect(result.datasetVersions.universe).toBe('dsv_44444444444444444444444444444444');
+  });
+
+  it('loads stable result pages and keeps snapshot lineage metadata', async () => {
+    get.mockResolvedValueOnce({
+      data: {
+        run_id: 'run_qs_123',
+        screen_snapshot_id: 'ssn_22222222222222222222222222222222',
+        pipeline_snapshot_id: 'sps_33333333333333333333333333333333',
+        as_of: '2026-07-24',
+        dataset_versions: { universe: 'dsv_44444444444444444444444444444444' },
+        schema: { name: 'quant.screen_snapshot', version: '1.0.0' },
+        trace: { trace_id: 'trace-1', run_id: 'run-1', stage_id: 'stage-1' },
+        items: [
+          {
+            instrument_id: 'CN.XSHG.600519',
+            name: '贵州茅台',
+            status: 'passed',
+            rank: 1,
+            final_score: 92.4,
+          },
+        ],
+        page_size: 25,
+        cursor: null,
+        next_cursor: '25',
+        total_count: 80,
+      },
+    });
+
+    const page = await quantScreeningApi.getScreenRunResults('run_qs_123', { pageSize: 25 });
+
+    expect(get).toHaveBeenCalledWith('/api/v1/quant/screen-runs/run_qs_123/results', {
+      params: { page_size: 25, cursor: undefined },
+    });
+    expect(page.items[0].instrumentId).toBe('CN.XSHG.600519');
+    expect(page.nextCursor).toBe('25');
+    expect(page.trace.traceId).toBe('trace-1');
+  });
+
+  it('loads one result explanation row and compares two screen runs', async () => {
+    get
+      .mockResolvedValueOnce({
+        data: {
+          instrument_id: 'CN.XSHG.600519',
+          name: '贵州茅台',
+          status: 'passed',
+          rank: 1,
+          final_score: 92.4,
+          stage_scores: { l1_provider: 88, l2_factor: 94 },
+          factor_contributions: { roe_ttm: 0.31 },
+          explanation_steps: [
+            {
+              stage: 'l4_final',
+              rule_id: 'l4_final_passed',
+              reason: '通过 deterministic final screen gates',
+              authoritative: true,
+            },
+          ],
+        },
+      })
+      .mockResolvedValueOnce({
+        data: {
+          schema: { name: 'quant.screen_snapshot_comparison', version: '1.0.0' },
+          previous_run_id: 'run_qs_old',
+          current_run_id: 'run_qs_new',
+          added: ['CN.XSHG.600519'],
+          removed: [],
+          retained: ['CN.XSHE.000001'],
+          status_changes: [],
+          rank_changes: [{ instrument_id: 'CN.XSHE.000001', previous_rank: 2, current_rank: 1 }],
+          score_deltas: [{ instrument_id: 'CN.XSHE.000001', delta: 4.2 }],
+        },
+      });
+
+    const row = await quantScreeningApi.getScreenRunResult('run_qs_123', 'CN.XSHG.600519');
+    const comparison = await quantScreeningApi.compareScreenRuns('run_qs_old', 'run_qs_new');
+
+    expect(get).toHaveBeenNthCalledWith(
+      1,
+      '/api/v1/quant/screen-runs/run_qs_123/results/CN.XSHG.600519',
+    );
+    expect(row.explanationSteps?.[0]?.ruleId).toBe('l4_final_passed');
+    expect(get).toHaveBeenNthCalledWith(
+      2,
+      '/api/v1/quant/screen-runs/run_qs_new/comparison',
+      { params: { previous_run_id: 'run_qs_old' } },
+    );
+    expect(comparison.added).toEqual(['CN.XSHG.600519']);
+    expect(comparison.rankChanges[0].previousRank).toBe(2);
+  });
+});
