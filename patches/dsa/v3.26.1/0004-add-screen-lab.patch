+  Play,
+  RefreshCw,
+  Search,
+  ShieldCheck,
+  SlidersHorizontal,
+  Sparkles,
+} from 'lucide-react';
+import {
+  AppPage,
+  Badge,
+  Button,
+  Card,
+  Drawer,
+  EmptyState,
+  InlineAlert,
+  StatusDot,
+} from '../components/common';
+import {
+  quantScreeningApi,
+  type QuantScreenComparison,
+  type QuantScreenResultsPage,
+  type QuantScreenResultRow,
+  type QuantScreenRunAccepted,
+  type QuantScreenRunMode,
+} from '../api/quantScreening';
+
+const DEMO_SCREEN_DEFINITION_ID = 'screen_def_screen_lab_demo';
+const DEMO_SCREEN_DEFINITION_VERSION_ID = 'sdv_11111111111111111111111111111111';
+const DEMO_SCREEN_SNAPSHOT_ID = 'ssn_22222222222222222222222222222222';
+const DEMO_DATASET_VERSION = 'dsv_44444444444444444444444444444444';
+const DEFAULT_AS_OF = '2026-07-24';
+const DEFAULT_PAGE_SIZE = 25;
+
+type PageState = 'initial' | 'loading' | 'ready' | 'error' | 'permission-denied';
+
+type ScreenLabError = {
+  title: string;
+  message: string;
+};
+
+function formatScore(value?: number | null): string {
+  if (value == null || !Number.isFinite(Number(value))) {
+    return '-';
+  }
+  return Number(value).toFixed(1);
+}
+
+function formatObjectEntries(values?: Record<string, string | number> | null): string {
+  if (!values || Object.keys(values).length === 0) {
+    return '-';
+  }
+  return Object.entries(values)
+    .map(([key, value]) => `${key}: ${value}`)
+    .join(' · ');
+}
+
+function getErrorStatus(error: unknown): number | undefined {
+  if (typeof error !== 'object' || error === null) {
+    return undefined;
+  }
+  const response = (error as { response?: { status?: number } }).response;
+  return response?.status;
+}
+
+function getErrorMessage(error: unknown): string {
+  if (error instanceof Error && error.message.trim()) {
+    return error.message.trim();
+  }
+  if (typeof error === 'object' && error !== null) {
+    const data = (error as { response?: { data?: { title?: string; detail?: string; message?: string } } }).response?.data;
+    const message = data?.detail || data?.message || data?.title;
+    if (typeof message === 'string' && message.trim()) {
+      return message.trim();
+    }
+  }
+  return 'Unknown error';
+}
+
+function stateTone(status: string): 'success' | 'warning' | 'danger' | 'info' | 'default' {
+  if (status === 'passed' || status === 'queued' || status === 'completed') {
+    return 'success';
+  }
+  if (status === 'failed') {
+    return 'danger';
+  }
+  if (status === 'partial' || status === 'stale') {
+    return 'warning';
+  }
+  return 'info';
+}
+
+const PipelineStep: React.FC<{
+  icon: React.ComponentType<{ className?: string }>;
+  title: string;
