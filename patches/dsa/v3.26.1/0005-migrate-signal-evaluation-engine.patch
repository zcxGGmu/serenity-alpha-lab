+# -*- coding: utf-8 -*-
+"""Signal evaluation engine compatibility layer.
+
+This module gives the legacy T+N recommendation evaluation logic its accurate
+semantic name while keeping existing backtest imports and storage compatible.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from src.core.backtest_engine import (
+    OVERALL_SENTINEL_CODE,
+    BacktestEngine,
+    BacktestResultLike,
+    DailyBarLike,
+    EvaluationConfig,
+)
+
+
+SIGNAL_EVALUATION_TYPE = "signal"
+SIGNAL_EVALUATION_SEMANTIC_SCOPE = "legacy_signal_evaluation"
+
+
+@dataclass(frozen=True)
+class SignalEvaluationConfig(EvaluationConfig):
+    evaluation_type: str = SIGNAL_EVALUATION_TYPE
+
+
+class SignalEvaluationEngine(BacktestEngine):
+    """Legacy DSA signal evaluation engine, not a formal portfolio backtest."""
+
+    evaluation_type = SIGNAL_EVALUATION_TYPE
+    semantic_scope = SIGNAL_EVALUATION_SEMANTIC_SCOPE
+
+
+__all__ = [
+    "OVERALL_SENTINEL_CODE",
+    "SIGNAL_EVALUATION_SEMANTIC_SCOPE",
+    "SIGNAL_EVALUATION_TYPE",
+    "BacktestEngine",
+    "BacktestResultLike",
+    "DailyBarLike",
+    "EvaluationConfig",
+    "SignalEvaluationConfig",
+    "SignalEvaluationEngine",
+]
