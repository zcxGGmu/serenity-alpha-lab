@@ -0,0 +1,125 @@
+import apiClient from './index';
+import { toCamelCase } from './utils';
+
+export type ResearchReportSchemaRef = {
+  name: string;
+  version: string;
+};
+
+export type ResearchReportNotificationStatus = {
+  messageId: string;
+  channel: string;
+  dedupeKey: string;
+  status: string;
+  attempt: number;
+  lastError?: string | null;
+  sentAt?: string | null;
+};
+
+export type ResearchReportEvidenceSummary = {
+  evidenceId: string;
+  kind: string;
+  evaluationScope: string;
+  title: string;
+  summary: string;
+  availableAt: string;
+  trust: string;
+  source?: Record<string, unknown>;
+  sourceLink?: string | null;
+  datasetVersions?: Record<string, string>;
+  runId?: string | null;
+  stageId?: string | null;
+  traceId?: string | null;
+  artifact?: {
+    artifactId?: string;
+    artifactHash?: string;
+  } | null;
+  formulaVersions?: Record<string, string>;
+};
+
+export type ResearchReportCitationSummary = {
+  citationId: string;
+  evidenceId: string;
+  evidenceFieldPath: string;
+  citedValue?: unknown;
+  unit?: string | null;
+  formulaVersion?: string | null;
+  datasetVersions?: Record<string, string>;
+  runId?: string | null;
+  stageId?: string | null;
+  artifactHash?: string | null;
+  evidence: ResearchReportEvidenceSummary;
+};
+
+export type ResearchReportClaimSummary = {
+  claimId: string;
+  kind: string;
+  statement: string;
+  verificationStatus: string;
+  citationIds: string[];
+  computationPolicy?: string;
+  value?: unknown;
+  unit?: string | null;
+  formulaVersion?: string | null;
+  datasetVersions?: Record<string, string>;
+  warnings?: string[];
+  citations: ResearchReportCitationSummary[];
+};
+
+export type ResearchReportPagePayload = {
+  contractVersion: string;
+  schema: ResearchReportSchemaRef;
+  authority: string;
+  authoritativeJsonHash: string;
+  renderingHash: string;
+  markdownSource: string;
+  htmlSource: string;
+  report: {
+    reportId: string;
+    reportLevel: string;
+    asOf: string;
+    generatedAt?: string | null;
+    runId?: string | null;
+    traceId?: string | null;
+  };
+  displayContext: {
+    title?: string;
+    model?: { provider?: string; name?: string; version?: string };
+    cost?: { currency?: string; totalCostUsd?: string };
+    riskSummary?: string;
+    disclaimer?: string;
+  };
+  datasetVersions: Record<string, string>;
+  summary?: Record<string, unknown>;
+  validation?: {
+    issueCount?: number;
+    issues?: Array<Record<string, unknown>>;
+  };
+  claims: ResearchReportClaimSummary[];
+  citations: Array<Record<string, unknown>>;
+  evidenceLineage: ResearchReportEvidenceSummary[];
+  notificationStatuses: ResearchReportNotificationStatus[];
+  citationGraphHash: string;
+  display: {
+    markdown: string;
+    html: string;
+  };
+};
+
+function reportUrl(reportId: string): string {
+  return `/api/v1/research/reports/${encodeURIComponent(reportId)}`;
+}
+
+export const researchReportsApi = {
+  async getReportPage(reportId: string): Promise<ResearchReportPagePayload> {
+    const response = await apiClient.get<Record<string, unknown>>(reportUrl(reportId));
+    return toCamelCase<ResearchReportPagePayload>(response.data);
+  },
+
+  async listReportNotifications(reportId: string): Promise<ResearchReportNotificationStatus[]> {
+    const response = await apiClient.get<Record<string, unknown>[]>(
+      `${reportUrl(reportId)}/notifications`,
+    );
+    return toCamelCase<ResearchReportNotificationStatus[]>(response.data);
+  },
+};
