@@ -0,0 +1,282 @@
+import type React from 'react';
+import { useEffect, useMemo, useState } from 'react';
+import { Bell, BookOpen, Boxes, Clock3, FileText, Link2, ShieldCheck, WalletCards } from 'lucide-react';
+import { useParams } from 'react-router-dom';
+import { AppPage, Badge, Button, Card, EmptyState, InlineAlert } from '../components/common';
+import {
+  researchReportsApi,
+  type ResearchReportClaimSummary,
+  type ResearchReportNotificationStatus,
+  type ResearchReportPagePayload,
+} from '../api/researchReports';
+
+type PageState = 'loading' | 'ready' | 'error';
+
+type ReportLoadState = {
+  reportId: string;
+  pageState: PageState;
+  report: ResearchReportPagePayload | null;
+  notifications: ResearchReportNotificationStatus[];
+  error: string | null;
+};
+
+function statusTone(status: string): 'success' | 'warning' | 'danger' | 'info' | 'default' {
+  if (status === 'verified' || status === 'sent') {
+    return 'success';
+  }
+  if (status === 'partial' || status === 'pending' || status === 'sending') {
+    return 'warning';
+  }
+  if (status === 'blocked' || status === 'dead_letter' || status === 'rejected') {
+    return 'danger';
+  }
+  return 'info';
+}
+
+function formatObjectEntries(values?: Record<string, string> | null): string {
+  if (!values || Object.keys(values).length === 0) {
+    return '-';
+  }
+  return Object.entries(values).map(([key, value]) => `${key}: ${value}`).join(' · ');
+}
+
+function errorMessage(error: unknown): string {
+  if (error instanceof Error && error.message.trim()) {
+    return error.message.trim();
+  }
+  const response = (error as { response?: { data?: { title?: string; detail?: string; message?: string } } } | null)?.response;
+  return response?.data?.detail || response?.data?.message || response?.data?.title || 'Unknown error';
+}
+
+const ReportMeta: React.FC<{ report: ResearchReportPagePayload }> = ({ report }) => (
+  <div className="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
+    <Card padding="sm">
+      <p className="flex items-center gap-2 text-xs text-secondary-text"><ShieldCheck className="h-4 w-4" />Authority</p>
+      <p className="mt-2 break-all font-mono text-xs text-foreground">{report.authority}</p>
+      <p className="mt-1 break-all font-mono text-xs text-secondary-text">{report.authoritativeJsonHash}</p>
+    </Card>
+    <Card padding="sm">
+      <p className="flex items-center gap-2 text-xs text-secondary-text"><Clock3 className="h-4 w-4" />As-of</p>
+      <p className="mt-2 font-mono text-xs text-foreground">{report.report.asOf}</p>
+      <p className="mt-1 text-xs text-secondary-text">{report.report.generatedAt || 'not recorded'}</p>
+    </Card>
+    <Card padding="sm">
+      <p className="flex items-center gap-2 text-xs text-secondary-text"><WalletCards className="h-4 w-4" />Model / cost</p>
+      <p className="mt-2 text-sm text-foreground">
+        {report.displayContext.model?.provider} / {report.displayContext.model?.name}
+      </p>
+      <p className="mt-1 font-mono text-xs text-secondary-text">USD {report.displayContext.cost?.totalCostUsd || '-'}</p>
+    </Card>
+    <Card padding="sm">
+      <p className="flex items-center gap-2 text-xs text-secondary-text"><Boxes className="h-4 w-4" />Datasets</p>
+      <p className="mt-2 break-all text-xs text-foreground">{formatObjectEntries(report.datasetVersions)}</p>
+    </Card>
+  </div>
+);
+
+const NotificationStatusPanel: React.FC<{ statuses: ResearchReportNotificationStatus[] }> = ({ statuses }) => {
+  if (statuses.length === 0) {
+    return (
+      <EmptyState
+        title="No notification status"
+        description="Transactional Outbox rows appear here after report delivery is queued."
+        icon={<Bell className="h-8 w-8" />}
+      />
+    );
+  }
+  return (
+    <div className="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
+      {statuses.map((status) => (
+        <Card key={status.messageId} padding="sm">
+          <div className="flex items-start justify-between gap-3">
+            <div>
+              <p className="font-semibold text-foreground">{status.channel}</p>
+              <p className="mt-1 break-all font-mono text-xs text-secondary-text">{status.dedupeKey}</p>
+            </div>
+            <Badge variant={statusTone(status.status)}>{status.status}</Badge>
+          </div>
+          <p className="mt-3 text-xs text-secondary-text">attempt {status.attempt}</p>
+          {status.sentAt ? <p className="mt-1 font-mono text-xs text-success">{status.sentAt}</p> : null}
+          {status.lastError ? <p className="mt-1 text-xs text-danger">{status.lastError}</p> : null}
+        </Card>
+      ))}
+    </div>
+  );
+};
+
+const ClaimCard: React.FC<{ claim: ResearchReportClaimSummary }> = ({ claim }) => {
+  const [expanded, setExpanded] = useState(false);
+  return (
+    <Card padding="sm">
+      <div className="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
+        <div className="min-w-0">
+          <div className="flex flex-wrap items-center gap-2">
+            <Badge variant={statusTone(claim.verificationStatus)}>{claim.verificationStatus}</Badge>
+            <Badge variant="info">{claim.kind}</Badge>
+            {claim.unit ? <Badge variant="default">{claim.unit}</Badge> : null}
+          </div>
+          <p className="mt-3 text-sm font-semibold text-foreground">{claim.statement}</p>
+          <p className="mt-2 break-all font-mono text-xs text-secondary-text">
+            {claim.claimId} · citations {claim.citationIds.join(', ')}
+          </p>
+        </div>
+        <Button variant="secondary" size="sm" onClick={() => setExpanded((value) => !value)}>
+          <BookOpen className="h-4 w-4" />
+          {expanded ? 'Hide evidence' : 'Expand evidence'}
+        </Button>
+      </div>
+
+      {expanded ? (
+        <div className="mt-4 space-y-3 border-t border-border/70 pt-4">
+          {claim.citations.map((citation) => (
+            <div key={citation.citationId} className="rounded-xl border border-border/70 bg-surface/70 p-3">
+              <div className="flex flex-wrap items-center gap-2">
+                <Badge variant="info">{citation.citationId}</Badge>
+                <span className="font-mono text-xs text-secondary-text">{citation.evidenceFieldPath}</span>
+              </div>
+              <p className="mt-2 text-sm font-semibold text-foreground">{citation.evidence.title}</p>
+              <p className="mt-1 text-xs text-secondary-text">{citation.evidence.summary}</p>
+              <div className="mt-3 grid gap-2 text-xs text-secondary-text md:grid-cols-2">
+                <p className="break-all">Evidence: {citation.evidence.evidenceId}</p>
+                <p className="break-all">Artifact: {citation.evidence.artifact?.artifactId || '-'}</p>
+                <p className="break-all">Hash: {citation.artifactHash || citation.evidence.artifact?.artifactHash || '-'}</p>
+                <p className="break-all">Run: {citation.runId || citation.evidence.runId || '-'}</p>
+              </div>
+              {citation.evidence.sourceLink ? (
+                <p className="mt-3 flex items-center gap-2 break-all font-mono text-xs text-cyan">
+                  <Link2 className="h-3.5 w-3.5 shrink-0" />
+                  {citation.evidence.sourceLink}
+                </p>
+              ) : null}
+            </div>
+          ))}
+        </div>
+      ) : null}
+    </Card>
+  );
+};
+
+const ResearchReportPage: React.FC = () => {
+  const { reportId } = useParams();
+  const resolvedReportId = reportId || 'rpt_demo';
+  const [loadState, setLoadState] = useState<ReportLoadState>(() => ({
+    reportId: resolvedReportId,
+    pageState: 'loading',
+    report: null,
+    notifications: [],
+    error: null,
+  }));
+
+  useEffect(() => {
+    let active = true;
+    void Promise.all([
+      researchReportsApi.getReportPage(resolvedReportId),
+      researchReportsApi.listReportNotifications(resolvedReportId),
+    ])
+      .then(([nextReport, nextNotifications]) => {
+        if (!active) {
+          return;
+        }
+        setLoadState({
+          reportId: resolvedReportId,
+          pageState: 'ready',
+          report: nextReport,
+          notifications: nextNotifications.length > 0 ? nextNotifications : nextReport.notificationStatuses,
+          error: null,
+        });
+      })
+      .catch((loadError: unknown) => {
+        if (!active) {
+          return;
+        }
+        setLoadState({
+          reportId: resolvedReportId,
+          pageState: 'error',
+          report: null,
+          notifications: [],
+          error: errorMessage(loadError),
+        });
+      });
+
+    return () => {
+      active = false;
+    };
+  }, [resolvedReportId]);
+
+  const currentLoadState = loadState.reportId === resolvedReportId
+    ? loadState
+    : {
+        reportId: resolvedReportId,
+        pageState: 'loading' as const,
+        report: null,
+        notifications: [],
+        error: null,
+      };
+  const { pageState, report, notifications, error } = currentLoadState;
+  const validationIssues = useMemo(() => report?.validation?.issues || [], [report]);
+
+  return (
+    <AppPage>
+      <div data-testid="research-report-page" className="space-y-5">
+        <div className="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
+          <div>
+            <p className="label-uppercase">Trusted Research</p>
+            <h1 className="mt-2 flex items-center gap-2 text-2xl font-bold text-foreground">
+              <FileText className="h-6 w-6 text-cyan" />
+              {report?.displayContext.title || 'Research Report'}
+            </h1>
+            <p className="mt-2 max-w-3xl text-sm text-secondary-text">
+              Claims expand to citations, evidence lineage, source links and Artifact hashes from canonical JSON.
+            </p>
+          </div>
+          {report ? <Badge variant={statusTone(report.report.reportLevel)} size="md">{report.report.reportLevel}</Badge> : null}
+        </div>
+
+        {pageState === 'loading' ? (
+          <EmptyState title="Loading report" description="Fetching trusted report payload and Outbox status." icon={<Clock3 className="h-8 w-8" />} />
+        ) : null}
+
+        {pageState === 'error' ? (
+          <InlineAlert title="Report load failed" message={error || 'Unknown error'} variant="danger" />
+        ) : null}
+
+        {pageState === 'ready' && report ? (
+          <>
+            <ReportMeta report={report} />
+            <InlineAlert
+              title="Authority"
+              message={`${report.markdownSource}; Markdown and HTML remain display formats derived from canonical JSON.`}
+              variant="info"
+            />
+            <Card title="Risk and disclaimer" subtitle="Report context">
+              <p className="text-sm text-foreground">{report.displayContext.riskSummary}</p>
+              <p className="mt-2 text-xs text-secondary-text">{report.displayContext.disclaimer}</p>
+            </Card>
+            <section className="space-y-3">
+              <div className="flex items-center justify-between gap-3">
+                <h2 className="text-lg font-semibold text-foreground">Claims and citations</h2>
+                <Badge variant="info">{report.claims.length} claims</Badge>
+              </div>
+              {report.claims.length > 0 ? report.claims.map((claim) => <ClaimCard key={claim.claimId} claim={claim} />) : (
+                <EmptyState title="No claims" description="No claims survived citation validation." icon={<FileText className="h-8 w-8" />} />
+              )}
+            </section>
+            <section className="space-y-3">
+              <h2 className="text-lg font-semibold text-foreground">Notification Outbox</h2>
+              <NotificationStatusPanel statuses={notifications} />
+            </section>
+            {validationIssues.length > 0 ? (
+              <InlineAlert
+                title="Validation issues"
+                message={validationIssues.map((issue) => String(issue.code || issue.message || 'issue')).join(', ')}
+                variant="warning"
+              />
+            ) : null}
+          </>
+        ) : null}
+      </div>
+    </AppPage>
+  );
+};
+
+export default ResearchReportPage;
