+}));
+
+vi.mock('../index', () => ({
+  default: {
+    get,
+  },
+}));
+
+describe('researchReportsApi', () => {
+  beforeEach(() => {
+    get.mockReset();
+  });
+
+  it('loads trusted report pages from the research report namespace', async () => {
+    get.mockResolvedValueOnce({
+      data: {
+        contract_version: 'research.report_delivery_ui@1.0.0',
+        schema: { name: 'research.report_page', version: '1.0.0' },
+        authority: 'canonical_json',
+        authoritative_json_hash: 'sha256:' + 'a'.repeat(64),
+        rendering_hash: 'sha256:' + 'b'.repeat(64),
+        markdown_source: 'derived_from_authoritative_json',
+        html_source: 'derived_from_authoritative_json',
+        report: {
+          report_id: 'rpt_delivery',
+          report_level: 'verified',
+          as_of: '2026-07-29T15:30:00+00:00',
+        },
+        display_context: {
+          title: 'Trusted Alpha Delivery Report',
+          model: { provider: 'openai', name: 'gpt-4.1-mini', version: '2026-07-01' },
+          cost: { total_cost_usd: '0.123456' },
+          risk_summary: 'Risk gate remains block.',
+          disclaimer: 'Research only; not investment advice.',
+        },
+        dataset_versions: { adjusted_daily_bars: 'dsv_11111111111111111111111111111111' },
+        claims: [
+          {
+            claim_id: 'cl_metric',
+            kind: 'numeric_metric',
+            statement: 'The formal portfolio backtest cumulative return was 12.0%.',
+            verification_status: 'verified',
+            citation_ids: ['cit_metric'],
+            citations: [
+              {
+                citation_id: 'cit_metric',
+                evidence_id: 'ev_metric',
+                evidence_field_path: 'body.returns.cumulative_return',
+                evidence: {
+                  evidence_id: 'ev_metric',
+                  kind: 'backtest_performance_metrics',
+                  evaluation_scope: 'formal_portfolio_backtest',
+                  title: 'Backtest metric evidence',
+                  summary: 'Formal backtest cumulative return metric.',
+                  available_at: '2026-07-29T15:30:00+00:00',
+                  trust: 'authoritative',
+                  source_link: 'artifact://tenant/run/metrics@sha256',
+                  artifact: { artifact_id: 'art_metrics', artifact_hash: 'sha256:' + 'a'.repeat(64) },
+                },
+              },
+            ],
+          },
+        ],
+        citations: [],
+        evidence_lineage: [],
+        notification_statuses: [],
+        citation_graph_hash: 'sha256:' + 'c'.repeat(64),
+        display: { markdown: '# Trusted Alpha Delivery Report', html: '<article />' },
+      },
+    });
+
+    const page = await researchReportsApi.getReportPage('rpt_delivery');
+
+    expect(get).toHaveBeenCalledWith('/api/v1/research/reports/rpt_delivery');
+    expect(page.contractVersion).toBe('research.report_delivery_ui@1.0.0');
+    expect(page.authority).toBe('canonical_json');
+    expect(page.claims[0].claimId).toBe('cl_metric');
+    expect(page.claims[0].citations[0].evidence.sourceLink).toBe('artifact://tenant/run/metrics@sha256');
+    expect(page.markdownSource).toBe('derived_from_authoritative_json');
+    expect(page.htmlSource).toBe('derived_from_authoritative_json');
+  });
+
+  it('loads notification Outbox status without calling a send endpoint', async () => {
+    get.mockResolvedValueOnce({
+      data: [
+        {
+          message_id: 'msg-report-email',
+          channel: 'email',
+          dedupe_key: 'report:rpt_delivery:email',
+          status: 'sent',
+          attempt: 1,
+          sent_at: '2026-07-29T15:31:00+00:00',
+        },
+      ],
+    });
+
+    const statuses = await researchReportsApi.listReportNotifications('rpt_delivery');
+
+    expect(get).toHaveBeenCalledWith('/api/v1/research/reports/rpt_delivery/notifications');
+    expect(statuses[0].messageId).toBe('msg-report-email');
+    expect(statuses[0].dedupeKey).toBe('report:rpt_delivery:email');
+  });
+});
diff --git a/apps/dsa-web/src/api/researchReports.ts b/apps/dsa-web/src/api/researchReports.ts
